# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# Both are public by design: the anon key is safe in the browser because RLS,
# not secrecy, is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth (required once Phase 1 ships) ------------------------------------
# Origin used to build the magic-link redirect. Set per environment and do NOT
# derive it from request headers -- that works locally and then mails
# preview-deployment users a link to a preview URL that gets torn down.
#   local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Service role (server-only, Phase 2) -----------------------------------
# BYPASSES ROW LEVEL SECURITY. Used only by the Stripe webhook to write
# entitlements. Must never be prefixed NEXT_PUBLIC_, never imported into a
# client component, and never logged. If this leaks, every user's data is
# readable and writable.
SUPABASE_SERVICE_ROLE_KEY=

# --- MCP endpoint ----------------------------------------------------------
# Bearer token for src/app/api/[transport]/route.ts. Auth fails closed: if this
# is unset the endpoint refuses every request rather than allowing them.
MCP_AUTH_TOKEN=

# --- Team branding ---------------------------------------------------------
# 'espn' (default) hotlinks team logos from a.espncdn.com; 'off' renders a
# neutral color-chip mark sitewide. See src/components/TeamMark.tsx and
# docs/MONETIZATION_ROADMAP.md Phase 0.
# NEXT_PUBLIC_TEAM_LOGOS=espn
