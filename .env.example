# --- Dashboard (required to run at all) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase anon key (public)

# --- Hosted MCP server (/api/mcp) -------------------------------------------
MCP_AUTH_TOKEN=                      # Bearer token external MCP consumers present

# --- Chart image route (/api/chart) -----------------------------------------
CHART_SIGNING_SECRET=                # HMAC secret for signed chart URLs
CHART_BASE_URL=                      # Optional; falls back to VERCEL_PROJECT_PRODUCTION_URL

# --- Scouting feed -----------------------------------------------------------
NEXT_PUBLIC_SCOUT_API_URL=           # cfb-scout API base (default http://localhost:8000)

# --- eve agent (all optional at build; features degrade when unset) ---------
ANTHROPIC_API_KEY=                   # Anthropic key for the agent models (Sonnet 5 + Opus 4.8 advisor)
SUPABASE_SERVICE_ROLE_KEY=           # Service role; agent reads bot-schema profiles/settings/picks
EVE_JWT_SECRET=                      # HMAC secret shared with the Discord bot's eve client (HS256,
                                     # iss cfb-bot / aud cfb-agent); unset = bot path disabled
FIRECRAWL_API_KEY=                   # Firecrawl key for web_search/read_page; unset = web tools report disabled
WEB_SEARCH_MAX_USES=3                # Per-answer web access budget shared by web_search + read_page; 0 disables
ADMIN_DISCORD_IDS=                   # Comma-separated Discord snowflakes allowed into /admin/*

# --- Memory graph (optional; memory features disable cleanly when unset) ----
MEMORY_ENDPOINT=                     # Base URL of the cfb-agent-memory Railway service
                                     # (see memory-server/README.md)
MEMORY_JWT_SECRET=                   # HS256 shared secret, same value as the memory
                                     # service's MEMORY_JWT_SECRET / FASTMCP_SERVER_AUTH_JWT_PUBLIC_KEY
MEMORY_ADMIN_TOKEN=                  # Bearer the Discord bot presents to /api/memory (bot-only
                                     # credential -- deliberately NOT MCP_AUTH_TOKEN; unset = route disabled)
